{
  "name": "imensite",
  "version": "2.0.0",
  "description": "ImenSite tutorial CMS, migrated to TypeScript",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongodb",
    "db:up": "docker compose up -d mongodb",
    "dev": "tsx watch app/server.ts",
    "lint": "eslint app --max-warnings=0",
    "start": "node dist/server.js",
    "test": "tsx --test app/utils/slug.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "author": "Kasra Karami",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^6.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "method-override": "^3.0.0",
    "mongoose": "^9.7.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pug": "^3.0.4",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/method-override": "^0.0.35",
    "@types/node": "^26.1.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  }
}
